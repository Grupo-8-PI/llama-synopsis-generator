RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_QUEUE_NAME=fila-exemplo
RABBITMQ_EXCHANGE_NAME=
RABBITMQ_ROUTING_KEY=
RABBITMQ_PREFETCH_COUNT=1

RABBITMQ_MAX_RETRIES=10
RABBITMQ_INITIAL_RETRY_DELAY=1.0
RABBITMQ_MAX_RETRY_DELAY=60.0
RABBITMQ_FAILURE_THRESHOLD=5
RABBITMQ_RECOVERY_TIMEOUT=30.0

RABBITMQ_QUEUE_MODE=passive
RABBITMQ_WAIT_FOR_QUEUE=true
RABBITMQ_QUEUE_CHECK_INTERVAL=5.0

# LLM Configuration (Hugging Face)
# Preencha HF_TOKEN (ou HF_API_KEY para compatibilidade) para usar API real
# Deixe ambos vazios para fallback
HF_TOKEN=
HF_API_KEY=
HF_MODEL=microsoft/DialoGPT-medium
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# API Callback Configuration
API_BASE_URL=http://localhost:8080
API_CALLBACK_ENDPOINT=/livros/atualizar/sinopse
API_TIMEOUT=30
